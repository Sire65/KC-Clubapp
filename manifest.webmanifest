{
  "name": "Köcheclub Werne",
  "short_name": "Köcheclub",
  "description": "Köcheclub Werne – Treffen, Nachrichten und mehr für unsere Mitglieder",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5eee3",
  "theme_color": "#741521",
  "lang": "de",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*",
            "application/pdf",
            "text/plain",
            ".txt",
            "application/zip",
            ".zip",
            "audio/*",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://sire65.github.io/KC-Clubapp/manifest.webmanifest"
    }
  ]
}
